{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["__isOptionsFunction"] }]
  },
  "ignorePatterns": ["node_modules/**", "scratch/**", "example/out.css"]
}
